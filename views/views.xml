<odoo>
  <data>

    <!-- list view for Consulting Document -->
    <record id="view_consulting_document_list" model="ir.ui.view">
      <field name="name">consulting.document.list</field>
      <field name="model">consulting.document</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="location"/>
          <field name="uploaded_by"/>
          <field name="upload_date"/>
        </list>
      </field>
    </record>

    <!-- Form view for Consulting Document -->
    <record id="view_consulting_document_form" model="ir.ui.view">
      <field name="name">consulting.document.form</field>
      <field name="model">consulting.document</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="document_file"/>
              <field name="location"/>
              <field name="uploaded_by"/>
              <field name="upload_date"/>
              <button name="action_import_and_send_whatsapp" type="object" string="Confirm"/>
            </group>
            <notebook>
              <page string="WhatsApp Logs">
                <field name="whatsapp_message_log_ids">
                  <list>
                    <field name="phone_number"/>
                    <field name="full_name"/>
                    <field name="location"/>
                    <field name="qualification"/>
                    <field name="status_code"/>
                    <field name="sent_at"/>
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Action for Consulting Document -->
    <record id="action_consulting_document" model="ir.actions.act_window">
      <field name="name">Consulting Documents</field>
      <field name="res_model">consulting.document</field>
      <field name="view_mode">list,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Create your first consulting document
        </p>
      </field>
    </record>

    <!-- Menu item for Consulting Document -->
    <menuitem id="menu_consulting_document_root" name="Consulting"/>
    <menuitem id="menu_consulting_document" name="Documents" parent="menu_consulting_document_root" action="action_consulting_document"/>

  </data>
</odoo>
